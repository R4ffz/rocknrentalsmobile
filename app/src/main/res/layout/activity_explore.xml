<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOSSOS SERVIÇOS"
            android:textColor="@color/roxo"
            android:textSize="18sp"
            android:fontFamily="@font/bebas_neue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="A Rock N’ Roll Rentals é uma empresa focada no artista! Fornecemos equipamentos de alta qualidade que inspiram músicos e garantem performances incríveis."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/rock_salt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="DEPOIMENTOS DE CLIENTES"
            android:textColor="@color/roxo"
            android:textSize="18sp"
            android:fontFamily="@font/bebas_neue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/black"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/roxo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="“A qualidade dos equipamentos é impecável! Consegui fazer meu show sem me preocupar com nada. Recomendo a todos!”"
                android:textColor="@color/white"
                android:fontFamily="@font/rock_salt"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="– João Guitar Hero"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/black"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/roxo">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="“O suporte da Rock N’ Roll Rentals foi excelente. Aluguei uma Gibson e o som estava incrível!”"
                android:textColor="@color/white"
                android:fontFamily="@font/rock_salt"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="– Maria Rock Star"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/bebas_neue" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="REFERÊNCIAS PROFISSIONAIS"
            android:textColor="@color/roxo"
            android:textSize="18sp"
            android:fontFamily="@font/bebas_neue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="• Bandas Locais: Black Thunder e Steel Wings\n• Artistas Independentes: Ana Noise e Gabriel Strings\n• Eventos: Festival de Rock Goiânia 2024"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/rock_salt" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="NOSSA SEDE"
            android:textColor="@color/roxo"
            android:textSize="18sp"
            android:fontFamily="@font/bebas_neue" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Conheça nosso espaço dedicado aos artistas, com equipamentos de última geração e ambiente inspirado no rock."
            android:textColor="@color/white"
            android:textSize="16sp"
            android:fontFamily="@font/rock_salt" />

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:src="@drawable/sede"
            android:adjustViewBounds="true"
            android:contentDescription="@null" />

        <Button
            android:id="@+id/btnVoltar"
            style="@android:style/Widget.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VOLTAR PARA HOME"
            android:textAllCaps="true"
            android:textColor="@color/white"
            android:fontFamily="@font/bebas_neue"
            android:background="@color/roxo"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp" />
    </LinearLayout>
</ScrollView>
